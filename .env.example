# ==============================================================================
# Getnet Multi-Agent Support System - Environment Configuration
# ==============================================================================

# Application Environment & Logging
# Supported environments: "development", "staging", "production"
ENVIRONMENT=development
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# LLM Provider & Model Settings (Required for /chat)
GEMINI_API_KEY=
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=2
MAX_SUPERVISOR_STEPS=6
MAX_SPECIALIST_STEPS=4

# RAG Vector Store & Knowledge Base Settings
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
RAG_TOP_K=4
RAG_MIN_SCORE=0.60
RAG_MIN_CHUNK_CHARS=120
INDEX_DIR=data/index

# Web Search Tool Settings (ddgs / DuckDuckGo)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
DDGS_TIMEOUT=8

# Safety Guardrails & Routing Thresholds
ENABLE_GUARDRAILS=true
CONFIDENCE_THRESHOLD_ESCALATION=0.45
