# ==============================================================================
# Getnet Multi-Agent Support System - Environment Configuration
# ==============================================================================

# Application Environment & Logging
# Supported environments: "development", "staging", "production"
ENVIRONMENT=development
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Secret salt for user_id hashing in structured logs (avoids precomputing known hashes)
LOG_HASH_SALT=

# LLM Provider & Model Settings (Required for /chat)
GEMINI_API_KEY=
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=2
MAX_SUPERVISOR_STEPS=6
MAX_SPECIALIST_STEPS=4

# RAG Vector Store & Knowledge Base Settings
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
RAG_TOP_K=4
RAG_MIN_SCORE=0.61
RAG_MIN_CHUNK_CHARS=120
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=
RAG_RERANK_TIMEOUT_S=10.0
RAG_DENSE_CANDIDATES=6
RAG_LEXICAL_CANDIDATES=6
RAG_RERANK_MIN_RELEVANCE=2
RAG_RRF_K=60
INDEX_DIR=data/index

# Web Search Tool Settings (ddgs / DuckDuckGo)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
DDGS_TIMEOUT=8
PUBLIC_DATA_TIMEOUT_S=8

# Safety Guardrails
ENABLE_GUARDRAILS=true
GUARDRAIL_CLASSIFIER_ENABLED=true
GUARDRAIL_CLASSIFIER_MODEL=
GUARDRAIL_CLASSIFIER_TIMEOUT_S=10
GUARDRAIL_CLASSIFIER_FAIL_MODE=open

# Authentication & Rate Limiting
# API_KEYS format: hash:user_id:role;hash:user_id:role;...
# Generate hash with: python -m src.core.auth hash
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# SQLite Checkpointer Persistence
CHECKPOINT_DB_PATH=data/checkpoints.db

# SQLite Tickets Storage
TICKETS_DB_PATH=data/tickets.db

# Auto-Escalation Threshold (consecutive abstentions without sources)
ESCALATE_AFTER_ABSTENTIONS=2

# Evaluation Runner & Judge Configuration
# EVAL_JUDGE_MODEL uses a distinct model from the evaluated system (e.g. gemini-3.1-flash-lite)
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
# Sleep interval between cases to respect AI Studio project quota limits (RPM/TPM)
EVAL_SLEEP_S=6.0
