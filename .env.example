# ==============================================================================
# Getnet Multi-Agent Support System - Environment Configuration
# ==============================================================================

# Application Environment & Logging
# Supported environments: "development", "staging", "production"
ENVIRONMENT=development
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported providers: "mock" (offline/unit test deterministic synthesis), "gemini", "openai"
LLM_PROVIDER=mock

# Google Gemini API Settings (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Knowledge Base & Vector Store Settings (ChromaDB)
# Path to local Getnet knowledge JSON and optional Chroma persistent storage directory
KB_DATA_PATH=data/getnet_kb.json
CHROMA_PERSIST_DIR=

# Web Search Tool Settings (ddgs / DuckDuckGo)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
DDGS_TIMEOUT=8

# Safety Guardrails & Routing Thresholds
ENABLE_GUARDRAILS=true
CONFIDENCE_THRESHOLD_ESCALATION=0.45
